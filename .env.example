# Telegram BotFather token. Never commit the real value.
BOT_TOKEN=

# Numeric ID of the private Telegram forum group for verification evidence.
VERIFY_GROUP_ID=-1004404717605

# Telegram numeric user ID allowed to run owner-only test commands.
OWNER_ID=

# Random secret used to validate Telegram webhook requests.
WEBHOOK_SECRET=

# Optional public base URL of the deployed function, without trailing slash.
WEBHOOK_BASE_URL=
